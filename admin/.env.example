# Clube Panda — Admin (Vite). Copie para .env e preencha com o SEU projeto Firebase.
# Pegue em: Firebase Console > Configurações do projeto > Seus apps > Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=clube-panda.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=clube-panda
VITE_FIREBASE_STORAGE_BUCKET=clube-panda.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: modo demo (bypassa auth como admin + dados fake, sem backend).
# Use pra demonstrar a UI sem projeto Firebase. Deixe vazio/false em produção.
VITE_DEMO=false
