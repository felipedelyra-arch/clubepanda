rules_version = '2';

// Clube Panda — Firestore Security Rules
//
// Coleções: users, subscriptions, plans, promotions, rewards, redemptions, payments
//
// Regra de ouro: escrita sensível (cobrança, assinatura, pagamentos, resgates,
// concessão de admin) roda APENAS em Cloud Functions com Admin SDK, que ignora
// estas rules. O cliente nunca escreve isso direto.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---- users ----
    // Cada usuário lê/escreve só os próprios dados. Admin lê todos.
    // Campo sensível (role) só o backend altera.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    // usuário não pode se auto-conceder role
                    && !('role' in request.resource.data);
      allow update: if isOwner(userId)
                    // usuário não pode mexer no próprio role
                    && request.resource.data.get('role', '') == resource.data.get('role', '');
      allow delete: if isAdmin();

      // ---- users/{userId}/notifications ----
      // Central de avisos. Dono lê e marca como lida (update). Criação/remoção
      // só backend (envio de push). Rules de subcoleção não herdam do doc pai.
      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId); // marcar como lida
        allow create, delete: if false;   // apenas Cloud Functions
      }
    }

    // ---- subscriptions ----
    // Somente leitura pelo dono/admin. Escrita só backend (Cloud Functions).
    match /subscriptions/{subId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // apenas Cloud Functions
    }

    // ---- config ----
    // Config pública do app (ex.: minBuild pra update obrigatório). Só admin escreve.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- plans ----
    // Leitura pública (vitrine de planos). Escrita só admin/backend.
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- promotions ----
    // Leitura pública. Escrita só admin.
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- rewards ----
    // Leitura pública. Escrita só admin.
    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- menu ----
    // Cardápio: um doc por prato, categoria é campo. Leitura pública (o app
    // mostra sem login), escrita só admin.
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- redemptions ----
    // Dono lê os próprios resgates. Admin lê todos. Escrita só backend
    // (resgate baixa estoque dentro da janela; validação marca como usado).
    match /redemptions/{redemptionId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // apenas Cloud Functions
    }

    // ---- payments ----
    // Só admin lê (financeiro). Escrita só backend (webhooks de pagamento).
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false; // apenas Cloud Functions
    }

    // fallback: nega tudo que não casou acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
