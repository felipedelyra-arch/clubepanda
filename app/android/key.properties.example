# Modelo do arquivo de assinatura de release.
#
# 1) Gere o keystore (guarde bem — perder essa chave significa nunca mais poder
#    atualizar o app publicado na Play Store):
#
#    keytool -genkey -v -keystore %USERPROFILE%\pandavip-upload.jks \
#      -storetype JKS -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2) Copie este arquivo para `android/key.properties` e preencha.
#    O `key.properties` e o `.jks` NÃO entram no git.

storePassword=SUA_SENHA_DO_KEYSTORE
keyPassword=SUA_SENHA_DA_CHAVE
keyAlias=upload
# Caminho absoluto, com barras normais: C:/Users/voce/pandavip-upload.jks
storeFile=CAMINHO/PARA/pandavip-upload.jks
